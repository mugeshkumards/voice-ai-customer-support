# =================================================================
# Environment Configuration for AI Voice Customer Support Agent
# =================================================================

# -----------------------------------------------------------------
# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/api_keys
# -----------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------
# Twilio Voice Configuration (Required for live incoming phone calls)
# Get credentials from: https://console.twilio.com/
# For local testing without Twilio, mock webhooks work with curl/Postman.
# -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------
# Voice & Speech Synthesis Settings
# Voice options: 'Polly.Amy', 'Polly.Joanna', 'Polly.Matthew', 'alice'
# -----------------------------------------------------------------
VOICE_NAME=Polly.Amy
VOICE_LANGUAGE=en-US

# -----------------------------------------------------------------
# Database Settings
# SQLite database file path
# -----------------------------------------------------------------
DATABASE_URL=sqlite:///./voice_support.db

# -----------------------------------------------------------------
# Server & Logging Settings
# -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
APP_ENV=development
